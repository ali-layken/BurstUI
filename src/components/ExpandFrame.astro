---
// Markup and styles for an app iframe that expands to the full screen: see src/lib/expandFrame.ts for the choreography.
import ExpandButton3D from "../islands/ExpandButton3D";

interface Props {
  src: string;
  title: string;
  /** Background behind the iframe (and the frame while it loads). */
  bg: string;
}
const { src, title, bg } = Astro.props;
---

<div id="xf-slot" class="xf-slot">
  <div id="xf-frame" class="xf-frame" style={`background-color: ${bg};`}>
    <iframe id="xf-iframe" src={src} style="width: 100%; height: 100%; border: none;" title={title}></iframe>
  </div>
</div>
<div id="xf-bar" class="xf-bar">
  {Astro.slots.has("bar-left") && <div class="xf-bar-left"><slot name="bar-left" /></div>}
  <ExpandButton3D client:load id="xf-expand" />
</div>

<style is:global>
  .xf-slot {
    position: relative;
    width: 100%;
    height: 75vh;
  }
  .xf-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* Expanded: the frame is already full-screen (one iframe resize, so the app's canvas isn't re-laid-out every frame) and a
     clip-path reveal does the animating on the compositor. */
  .xf-frame.moving {
    position: fixed;
    inset: 0;
    z-index: 9999;
    will-change: clip-path;
    transition: clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* The button sits under the frame and flies to the bottom centre of the screen on expand. */
  .xf-bar {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 12px;
  }
  /* The button sits XF_GAP below the frame and the panel ends XF_GAP below the button: equal, tight margins instead of
     the panel's normal bottom padding. */
  :root {
    --xf-gap: 12px;
    --xf-wire-room: 14px; /* frame line + the text plate's widest edge (narrow screens grow plates by 8px) */
  }
  .xf-bar {
    padding-top: var(--xf-gap) !important;
  }
  #component-container:has(#xf-bar),
  #main-container:has(#xf-bar) {
    padding-bottom: var(--xf-gap);
  }
  /* On wide screens the content panel is stretched to the sidebar's height; let the frame take up that extra room
     rather than leaving dead space under the button. */
  #component-container:has(#xf-bar) {
    display: flex;
    flex-direction: column;
  }
  #component-container:has(#xf-bar) > .xf-slot {
    flex: 1 0 auto;
    min-height: 75vh;
  }
  /* Optional content on the left of the bar (e.g. a source link), tucked into the panel's bottom-left corner with the
     same XF_GAP from both edges, plus --xf-wire-room so it (and its text plate's wavy edge) clears the wire frame's
     double line. Absolutely positioned so the expand button stays centred in the bar, which
     expandFrame.ts relies on for its fly-out position. The negative left cancels the panel's side padding
     (main px-5 + component px-2 on narrow screens, component md:px-8 on wide). */
  .xf-bar-left {
    position: absolute;
    left: calc(var(--xf-gap) + var(--xf-wire-room) - 28px);
    bottom: var(--xf-wire-room);
    display: flex;
    align-items: flex-end;
    line-height: 1;
  }
  @media (min-width: 1463px) {
    /* Tailwind's md (tailwind.config.ts), where the component panel's md:px-8 kicks in. */
    .xf-bar-left {
      left: calc(var(--xf-gap) + var(--xf-wire-room) - 32px);
    }
  }
  /* Narrow screens: pin the bar-left content to the screen's bottom-left, level with the floating sidebar toggle and
     matching the home page contact block (pb-7, and the same left edge), instead of under the frame. Dropping the
     bar's position makes the page itself the positioning box. */
  @media (max-width: 1462.98px) {
    .xf-bar {
      position: static;
    }
    .xf-bar-left {
      left: 31px;
      bottom: 28px;
    }
  }
  .expand-button-3d {
    display: block;
    padding: 0;
    border: 0;
    line-height: 0;
    background: transparent;
    cursor: pointer;
    border-radius: 16px;
    transition: background-color 0.3s;
  }
  /* Over the expanded app the dim arrows get a soft dark halo (no box) so they stay readable. */
  .expand-button-3d.xf-flying canvas {
    filter: drop-shadow(0 0 5px rgba(8, 12, 20, 0.85));
  }
  .xf-flying {
    position: fixed !important;
    z-index: 10000;
    margin: 0;
    transition:
      top 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      left 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>
