---
import { ClientRouter } from "astro:transitions";
import ResizeDetector from "../islands/ResizeDetector";
import BackButton3D from "../islands/BackButton3D";
import OceanBackground from "../islands/OceanBackground";
import "../styles/styles.css";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/blog/Foo" - joined with Astro.site for canonical/og:url. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  robots?: string;
  /** Opaque content panel for long-form reading (blog posts); default is the wire-framed panel over the ocean. */
  solid?: boolean;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  robots,
  solid = false,
} = Astro.props;

// Below md the content panel is the whole screen (#main-container); above it, a card beside the sidebar
// (#component-container). styles.css .wire-frame-* draws the frame on whichever is the panel at that width.
const panelNarrow = solid ? "bg-bgAquaSolid shadow-lg" : "wire-frame-narrow";
const panelWide = solid ? "md:bg-bgAquaSolid md:shadow-lg" : "wire-frame-wide";

const absolute = new URL(path, Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={absolute} />

    <meta property="og:image" content="/logo.png" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={absolute} />
    <meta property="og:type" content={ogType} />
    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <ResizeDetector client:load />
    <OceanBackground client:load transition:persist />
    <div class="layout">
      <div id="background-container" class="min-h-screen flex flex-col items-center">
        <div
          id="main-container"
          class:list={[
            "w-full min-w-0 max-w-4xl min-h-screen px-5 py-8 rounded-md md:flex md:justify-center md:gap-8 md:max-w-full md:min-h-0 md:bg-transparent md:shadow-none",
            panelNarrow,
          ]}
        >
          <div id="wide-nav-container" class="hidden md:flex wide-nav">
            <slot name="nav">
              <div id="site-nav-container">
                <BackButton3D client:load />
              </div>
            </slot>
          </div>
          <div
            id="component-container"
            class:list={["w-full max-w-4xl px-2 py-0 rounded-md md:relative md:px-8 md:py-8", panelWide]}
          >
            <slot />
          </div>
        </div>
        <div id="wide-bottom-or-narrow-nav-container"></div>
      </div>
    </div>
  </body>
</html>
