---
import { ClientRouter } from "astro:transitions";
import ResizeDetector from "../islands/ResizeDetector";
import BackButton3D from "../islands/BackButton3D";
import OceanBackground from "../islands/OceanBackground";
import "../styles/styles.css";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/blog/Foo" - joined with Astro.site for canonical/og:url. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  /** Rendered verbatim inside <head> for page-specific meta (article:*). */
  robots?: string;
  /** Opaque content panel (long-form reading); default is translucent over the ocean. */
  solid?: boolean;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  robots,
  solid = false,
} = Astro.props;

// Solid pages (blog posts) get a filled content panel for reading; everything else gets a wireframe panel over the
// ocean (styles.css). The sidebar is a wireframe on every page.
// TEMP switch: true = on wide screens the wire panels are filled with the old 96% panel colour (no text plate
// backgrounds); on narrow screens the panels stay see-through and text sits on plain rounded 96% plates. Blog content
// stays 100% either way. false = see-through wire panels with flower-edged plates everywhere (tag wire-complete-gas).
const FILLED_PANELS = true;

const panelBg = solid ? "bg-bgAquaSolid shadow-lg" : "wire-frame-narrow";
const panelBgMd = solid ? "md:bg-bgAquaSolid md:shadow-lg" : "wire-frame-wide";

const absolute = new URL(path, Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={absolute} />

    <meta property="og:image" content="/logo.png" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={absolute} />
    <meta property="og:type" content={ogType} />
    <slot name="head" />

    <ClientRouter />
  </head>
  <body class:list={[FILLED_PANELS && "filled-panels"]}>
    <ResizeDetector client:load />
    <OceanBackground client:load transition:persist />
    <div class="layout">
      <div
        id="background-container"
        class="min-h-screen flex flex-col items-center"
      >
        <div
          id="main-container"
          class:list={["w-full min-w-0 md:flex gap-8 justify-start md:justify-center", panelBg, "md:bg-transparent max-w-4xl md:max-w-full px-5 py-8 rounded-md md:shadow-none min-h-screen md:min-h-0"]}
        >
          <div
            id="wide-nav-container"
            class="hidden md:flex flex-2 w-[31rem] px-4 py-5 top-24 rounded-md self-start sticky flex-col wire-frame"
          >
            <slot name="nav">
              <div id="site-nav-container">
                <BackButton3D client:load />
              </div>
            </slot>
          </div>
          <div
            id="component-container"
            class:list={["max-w-4xl px-2 md:px-8 py-0 md:py-8 bg-none", panelBgMd, "rounded-md shadow-none static md:relative w-full"]}
          >
            <slot />
          </div>
        </div>
        <div id="wide-bottom-or-narrow-nav-container"></div>
      </div>
    </div>
    <script>
      import { initPlateShapes } from "../lib/plateShapes";
      // New random flower outlines for the text plates on every page load (and every client-side navigation).
      document.addEventListener("astro:page-load", () => {
        if (!document.body.classList.contains("filled-panels")) initPlateShapes();
      });
    </script>
  </body>
</html>
