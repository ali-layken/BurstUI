---
import Base from "../layouts/Base.astro";
import BackButton3D from "../islands/BackButton3D";
import { burstColors } from "../lib/colors";
---

<Base
  title="Movement Map"
  description="Movement Map: where to live in the Americas"
  path="/movement-map"
  ogDescription="Interactive map of 346 Americas cities and ~2,600 opportunity sites, filterable by temperature, time zone, housing cost and more"
>
  <div id="site-nav-container" slot="nav">
    <h2 class="font-fixel ml-4 mb-2 text-accRed2 text-3xl md:text-4xl font-semibold">
      Sources:
    </h2>
    <dl class="ml-6 mr-4 mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-accLiteGreen text-base md:text-lg font-medium font-fixel">
      <dt class="font-semibold text-subtitles">Climate</dt>
      <dd>Meteostat · Open-Meteo · NASA</dd>
      <dt class="font-semibold text-subtitles">US housing</dt>
      <dd>Zillow Research</dd>
      <dt class="font-semibold text-subtitles">Other housing</dt>
      <dd>FipeZap · CREA · CMHC · Banorte</dd>
      <dt class="font-semibold text-subtitles">US income</dt>
      <dd>Census Bureau ACS</dd>
      <dt class="font-semibold text-subtitles">Places</dt>
      <dd>OurAirports · Wikidata · IPEDS</dd>
      <dt class="font-semibold text-subtitles">Locations</dt>
      <dd>Wikipedia · OpenStreetMap</dd>
      <dt class="font-semibold text-subtitles">Currency</dt>
      <dd>ECB via Frankfurter</dd>
      <dt class="font-semibold text-subtitles">Basemap</dt>
      <dd>Natural Earth · MapLibre</dd>
    </dl>
    <p class="ml-6 mr-4 mb-2 text-skyBlue text-xs md:text-sm font-fixel leading-snug">
      Meteostat data is CC BY-NC 4.0 and Open-Meteo (ERA5) CC BY 4.0. Contains modified Copernicus Climate Change Service
      information. MLS® is a trademark of CREA.
    </p>
    <p class="ml-6 mr-4 mb-2 text-skyBlue text-xs md:text-sm font-fixel leading-snug">
      Non-commercial hobby project. Housing figures are indicative and many site locations are approximate.
    </p>

    <BackButton3D client:load />
  </div>

  <div id="mm-slot" class="mm-slot">
  <div id="mm-frame" class="mm-frame">
    <button
      id="mm-expand"
      type="button"
      class="mm-expand font-fixel"
      aria-pressed="false"
      title="Expand (Esc to close)">⤢ Expand</button>
    <iframe
      id="mm-iframe"
      src="/movement-map/index.html"
      style="width: 100%; height: 100%; border: none;"
      title="Movement Map"></iframe>
  </div>
  </div>
</Base>

<style define:vars={{ bg: burstColors.bgAqua, orange: burstColors.accOrange, purple: burstColors.bgPurple }}>
  .mm-slot {
    position: relative;
    width: 100%;
    height: 75vh;
  }
  .mm-frame {
    position: absolute;
    inset: 0;
    background-color: var(--bg);
    overflow: hidden;
  }
  /* Expanded: the frame is already full-screen (one iframe resize, so the
     map's WebGL canvas isn't re-laid-out every frame) and a clip-path
     reveal does the animating on the compositor. */
  .mm-frame.moving {
    position: fixed;
    inset: 0;
    z-index: 9999;
    will-change: clip-path;
    transition: clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-expand {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 6px 12px;
    border-radius: 6px;
    border: 2px solid var(--orange);
    background: var(--purple);
    color: var(--orange);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .mm-expand:hover {
    background: var(--orange);
    color: white;
  }
</style>

<script>
  // The map's sidebar is closed in the embedded view and opened when
  // expanded. The iframe is same-origin, so click its own toggle rather than
  // reloading it (keeps the map's view and filters).
  function init() {
    const frame = document.getElementById("mm-frame");
    const btn = document.getElementById("mm-expand");
    const iframe = document.getElementById("mm-iframe") as HTMLIFrameElement | null;
    if (!frame || !btn || !iframe) return;

    const setSidebar = (open: boolean) => {
      const doc = iframe.contentDocument;
      const toggle = doc?.getElementById("panelToggle");
      if (!doc || !toggle) return;
      if (doc.body.classList.contains("panel-closed") === open) toggle.click();
    };

    const slot = document.getElementById("mm-slot")!;
    const clipTo = (r: DOMRect) =>
      `inset(${r.top}px ${innerWidth - r.right}px ${innerHeight - r.bottom}px ${r.left}px)`;
    let expanded = false;
    let token = 0;

    const setExpanded = (next: boolean) => {
      expanded = next;
      const mine = ++token;
      btn.textContent = next ? "✕ Close" : "⤢ Expand";
      btn.setAttribute("aria-pressed", String(next));
      setSidebar(next);
      if (next) {
        const r = slot.getBoundingClientRect();
        frame.style.transition = "none";
        frame.style.clipPath = clipTo(r);
        frame.classList.add("moving");
        void frame.offsetWidth;
        frame.style.transition = "";
        document.body.style.overflow = "hidden";
        frame.style.clipPath = "inset(0px)";
      } else {
        frame.style.clipPath = clipTo(slot.getBoundingClientRect());
        const done = () => {
          if (mine !== token) return;
          frame.classList.remove("moving");
          frame.removeAttribute("style");
          document.body.style.overflow = "";
        };
        frame.addEventListener("transitionend", (e) => { if (e.target === frame) done(); });
        setTimeout(done, 700);
      }
    };

    btn.addEventListener("click", () => setExpanded(!expanded));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && expanded) setExpanded(false);
    });
    iframe.addEventListener("load", () => setSidebar(expanded));
    if (iframe.contentDocument?.readyState === "complete") setSidebar(false);
  }
  document.addEventListener("astro:page-load", init);
</script>
