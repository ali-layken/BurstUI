---
import Base from "../layouts/Base.astro";
import AnimatedText3D from "../islands/AnimatedText3D";
import CopyableText from "../islands/CopyableText";
import { listPosts } from "../lib/posts";

const posts = (await listPosts()).filter((p) => !p.draft);
const demos = [{ name: "Snake 2.5", route: "/snake" }];
---

<Base title="Home" description="Home Page" path="/" robots="index">
  <div id="site-nav-container" slot="nav">
    <h2 class="font-fixel ml-4 text-subtitles2 text-4xl font-semibold">
      Posts:
    </h2>
    <ul class="space-y-4 my-4">
      {
        posts.map((post, index) => (
          <li class="flex justify-between items-center w-full">
            <div class="flex items-center">
              <span class="text-3xl font-fixel tabular-nums mr-1 text-right w-8 text-skyBlue">
                <strong>{index + 1}.</strong>
              </span>
              <a
                href={`/blog/${post.slug}`}
                class="text-accGreen hover:text-accRed hover:underline text-lg md:text-xl font-fixel transition-colors duration-200 ml-2"
                data-action="close"
              >
                {post.name}:<br />
                <span class="italic font-source4 ml-4" data-action="close">
                  {post.subtitle}
                </span>
              </a>
            </div>
            <time class="text-sm md:text-lg font-fixel text-skyBlue" datetime={post.createdAt.toISOString()}>
              {post.createdAt.toLocaleDateString("en-US")}
            </time>
          </li>
        ))
      }
    </ul>
    <hr class="mx-2 my-4" />
    <h2 class="font-fixel ml-4 mt-4 mb-2 text-subtitles2 text-4xl font-semibold">
      Demos:
    </h2>
    <ul class="space-y-4">
      {
        demos.map((demo, index) => (
          <li class="flex justify-between items-center w-full">
            <div class="flex items-center">
              <span class="text-3xl font-fixel mr-1 text-right w-8 text-skyBlue">
                <strong>{index + 1}.</strong>
              </span>
              <a
                href={demo.route}
                class="text-accGreen hover:text-accRed hover:underline text-xl md:text-2xl italic font-source4 transition-colors duration-200 ml-2"
                data-action="close"
              >
                {demo.name}<br />
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <AnimatedText3D client:load text="Burst!" />
  <br />
  <p class="text-subtitles2 text-3xl text-center font-fixel mt-1 mb-24 text-pretty">
    <strong>Welcome</strong>, my <em>digitally wandering</em> visitor! This space
    is for sharing knowledge that I hope you can benefit from.
  </p>
  <div class="absolute bottom-0 flex items-center max-w-4xl pb-4 md:pb-3 -ml-4">
    <ul class="list-none space-y-2">
      <li class="flex flex-col text-skyBlue text-xl font-fixel">
        <span class="text-subtitles2 text-xs font-fixel mb-1">
          Bug reports / feature requests? Hit me up:
        </span>
        <div class="flex items-center">
          <img class="marked-emoji-img mr-1.5" alt="discord" src="/emojis/discord.svg" />
          <span class="mr-2">Discord:</span>
          <CopyableText client:load text="@supaboop" />
        </div>
      </li>
      <li class="flex items-center text-accRed2 text-xl font-fixel">
        <a
          class="text-accGreen hover:text-accRed hover:underline transition-colors duration-200"
          href="https://github.com/ali-layken"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img class="marked-emoji-img mr-1.5" alt="github" src="/emojis/github.png" />
          Github
        </a>
      </li>
    </ul>
  </div>
</Base>
