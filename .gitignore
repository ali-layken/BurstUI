# dotenv environment variable files
.env
.env.*
!.env.example

# Astro build output and cache
dist/
.astro/

# npm dependencies
node_modules/

# wrangler local state
.wrangler/

# generated from the vendor/movement-map submodule by scripts/build-movement-map.mjs
public/movement-map/

# screenshots from scripts/shot.mjs
.shots/

# scripts/deploy.mjs writes this while the D1 id is still the placeholder
wrangler.no-reports.jsonc
# local secrets for wrangler dev (REPORT_SALT=...)
.dev.vars
.dev.vars.*
